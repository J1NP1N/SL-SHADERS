+    bool ensure_pbr_alpha_snapshot_storage(
+        device_state &state,
+        uint32_t width,
+        uint32_t height)
+    {
+        if (state.pbr_alpha_before_texture != 0 &&
+            state.pbr_alpha_after_texture != 0 &&
+            state.pbr_alpha_read_fbo != 0 &&
+            state.pbr_alpha_width == width &&
+            state.pbr_alpha_height == height)
+            return true;
+
+        if (state.pbr_alpha_before_texture != 0)
+        {
+            glDeleteTextures(1, &state.pbr_alpha_before_texture);
+            state.pbr_alpha_before_texture = 0;
+        }
+
+        if (state.pbr_alpha_after_texture != 0)
+        {
+            glDeleteTextures(1, &state.pbr_alpha_after_texture);
+            state.pbr_alpha_after_texture = 0;
+        }
+
+        if (state.pbr_alpha_read_fbo != 0 &&
+            p_glDeleteFramebuffers != nullptr)
+        {
+            p_glDeleteFramebuffers(1, &state.pbr_alpha_read_fbo);
+            state.pbr_alpha_read_fbo = 0;
+        }
+
+        GLint previous_active_texture = 0;
+        glGetIntegerv(GL_ACTIVE_TEXTURE_VALUE, &previous_active_texture);
+        p_glActiveTexture(GL_TEXTURE0_VALUE + 13);
+
+        GLint previous_texture = 0;
+        glGetIntegerv(GL_TEXTURE_BINDING_2D_VALUE, &previous_texture);
+
+        auto create_snapshot_texture =
+            [&](GLuint &texture) -> bool
+            {
+                glGenTextures(1, &texture);
+                if (texture == 0)
+                    return false;
+
+                glBindTexture(GL_TEXTURE_2D_VALUE, texture);
+                glTexParameteri(GL_TEXTURE_2D_VALUE, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+                glTexParameteri(GL_TEXTURE_2D_VALUE, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+                glTexImage2D(
+                    GL_TEXTURE_2D_VALUE,
+                    0,
+                    static_cast<GLint>(GL_RGBA16F_VALUE),
+                    static_cast<GLsizei>(width),
+                    static_cast<GLsizei>(height),
+                    0,
+                    GL_RGBA_VALUE,
+                    GL_FLOAT_VALUE,
+                    nullptr);
+                return true;
+            };
+
+        const bool textures_ok =
+            create_snapshot_texture(state.pbr_alpha_before_texture) &&
+            create_snapshot_texture(state.pbr_alpha_after_texture);
+
+        glBindTexture(
+            GL_TEXTURE_2D_VALUE,
+            previous_texture > 0 ? static_cast<GLuint>(previous_texture) : 0);
+        p_glActiveTexture(static_cast<GLenum>(previous_active_texture));
+
+        if (!textures_ok)
+        {
+            if (state.pbr_alpha_before_texture != 0)
+            {
+                glDeleteTextures(1, &state.pbr_alpha_before_texture);
+                state.pbr_alpha_before_texture = 0;
+            }
+            if (state.pbr_alpha_after_texture != 0)
+            {
+                glDeleteTextures(1, &state.pbr_alpha_after_texture);
+                state.pbr_alpha_after_texture = 0;
+            }
+            return false;
+        }
+
+        p_glGenFramebuffers(1, &state.pbr_alpha_read_fbo);
+        if (state.pbr_alpha_read_fbo == 0)
+            return false;
+
+        state.pbr_alpha_width = width;
+        state.pbr_alpha_height = height;
+        return true;
+    }
+
+    bool copy_color_texture_to_snapshot(
+        GLuint source_texture,
+        GLuint destination_texture,
+        GLuint read_fbo,
+        uint32_t width,
+        uint32_t height)
+    {
+        if (source_texture == 0 ||
+            destination_texture == 0 ||
+            read_fbo == 0 ||
+            width == 0 ||
+            height == 0)
+            return false;
+
+        GLint previous_read_fbo = 0;
+        GLint previous_active_texture = 0;
+        glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING_VALUE, &previous_read_fbo);
+        glGetIntegerv(GL_ACTIVE_TEXTURE_VALUE, &previous_active_texture);
+
+        p_glActiveTexture(GL_TEXTURE0_VALUE + 13);
+        GLint previous_texture = 0;
+        glGetIntegerv(GL_TEXTURE_BINDING_2D_VALUE, &previous_texture);
+
+        p_glBindFramebuffer(GL_READ_FRAMEBUFFER_VALUE, read_fbo);
+        p_glFramebufferTexture2D(
+            GL_READ_FRAMEBUFFER_VALUE,
+            GL_COLOR_ATTACHMENT0_VALUE,
+            GL_TEXTURE_2D_VALUE,
+            source_texture,
+            0);
+
+        const bool complete =
+            p_glCheckFramebufferStatus(GL_READ_FRAMEBUFFER_VALUE) ==
+            GL_FRAMEBUFFER_COMPLETE_VALUE;
+
+        bool copied = false;
+        if (complete)
+        {
+            glReadBuffer(GL_COLOR_ATTACHMENT0_VALUE);
+            glBindTexture(GL_TEXTURE_2D_VALUE, destination_texture);
+            glCopyTexSubImage2D(
+                GL_TEXTURE_2D_VALUE,
+                0, 0, 0, 0, 0,
+                static_cast<GLsizei>(width),
+                static_cast<GLsizei>(height));
+            copied = true;
+        }
+
+        glBindTexture(
+            GL_TEXTURE_2D_VALUE,
+            previous_texture > 0 ? static_cast<GLuint>(previous_texture) : 0);
+        p_glActiveTexture(static_cast<GLenum>(previous_active_texture));
+        p_glBindFramebuffer(
+            GL_READ_FRAMEBUFFER_VALUE,
+            previous_read_fbo > 0 ? static_cast<GLuint>(previous_read_fbo) : 0);
+
+        return copied;
+    }
+
+    bool inspect_pbr_alpha_draw(
+        api::device *device,
+        pbr_alpha_draw_capture &candidate)
+    {
+        candidate = {};
+
+        if (!glIsEnabled(GL_BLEND))
+            return false;
+
+        GLint blend_src_rgb = 0;
+        GLint blend_dst_rgb = 0;
+        glGetIntegerv(GL_BLEND_SRC_RGB_VALUE, &blend_src_rgb);
+        glGetIntegerv(GL_BLEND_DST_RGB_VALUE, &blend_dst_rgb);
+
+        if (blend_src_rgb != static_cast<GLint>(GL_SRC_ALPHA_VALUE) ||
+            blend_dst_rgb != static_cast<GLint>(GL_ONE_MINUS_SRC_ALPHA_VALUE))
+            return false;
+
+        GLint raw_program = 0;
+        glGetIntegerv(GL_CURRENT_PROGRAM_VALUE, &raw_program);
+        if (raw_program <= 0)
+            return false;
+
+        const GLuint program = static_cast<GLuint>(raw_program);
+
+        texture_capture base_color = {};
+        texture_capture normal = {};
+        texture_capture orm = {};
+        texture_capture emissive = {};
+
+        if (!read_sampler_2d(device, program, "diffuseMap", base_color) ||
+            !read_sampler_2d(device, program, "bumpMap", normal) ||
+            !read_sampler_2d(device, program, "specularMap", orm) ||
+            !read_sampler_2d(device, program, "emissiveMap", emissive))
+            return false;
+
+        float metallic_factor = 0.0f;
+        float roughness_factor = 0.0f;
+        if (!read_float_uniform(program, "metallicFactor", &metallic_factor, 1) ||
+            !read_float_uniform(program, "roughnessFactor", &roughness_factor, 1))
+            return false;
+
+        texture_capture scene_target = {};
+        if (!read_draw_color_attachment(device, scene_target) ||
+            !scene_target.texture_bound ||
+            !scene_target.desc_valid ||
+            scene_target.texture == 0 ||
+            scene_target.desc.type != api::resource_type::texture_2d)
+            return false;
+
+        GLint viewport[4] = {};
+        glGetIntegerv(GL_VIEWPORT, viewport);
+        const bool viewport_valid = viewport[2] > 1 && viewport[3] > 1;
+
+        candidate.valid =
+            viewport_valid &&
+            base_color.texture_bound &&
+            normal.texture_bound &&
+            orm.texture_bound &&
+            emissive.texture_bound;
+
+        if (!candidate.valid)
+            return false;
+
+        candidate.program = program;
+        candidate.base_color = base_color;
+        candidate.normal = normal;
+        candidate.orm = orm;
+        candidate.emissive = emissive;
+        candidate.scene_target = scene_target;
+        candidate.metallic_factor = metallic_factor;
+        candidate.roughness_factor = roughness_factor;
+        candidate.viewport_valid = true;
+        candidate.blend_src_rgb = blend_src_rgb;
+        candidate.blend_dst_rgb = blend_dst_rgb;
+        std::memcpy(candidate.viewport, viewport, sizeof(viewport));
+        return true;
+    }
+
+    bool begin_pbr_alpha_segment(
+        device_state &state,
+        const pbr_alpha_draw_capture &candidate)
+    {
+        if (!candidate.valid ||
+            state.pbr_alpha_segment_active ||
+            state.pbr_alpha_pair_ready ||
+            !candidate.scene_target.desc_valid)
+            return false;
+
+        const uint32_t width = candidate.scene_target.desc.texture.width;
+        const uint32_t height = candidate.scene_target.desc.texture.height;
+
+        if (!ensure_pbr_alpha_snapshot_storage(state, width, height))
+            return false;
+
+        if (!copy_color_texture_to_snapshot(
+                candidate.scene_target.texture,
+                state.pbr_alpha_before_texture,
+                state.pbr_alpha_read_fbo,
+                width,
+                height))
+            return false;
+
+        state.pbr_alpha_segment_active = true;
+        state.pbr_alpha_segment_target = candidate.scene_target.texture;
+        return true;
+    }
+
+    bool finish_pbr_alpha_segment(device_state &state)
+    {
+        if (!state.pbr_alpha_segment_active ||
+            state.pbr_alpha_segment_target == 0 ||
+            state.pbr_alpha_pair_ready)
+            return false;
+
+        const bool copied =
+            copy_color_texture_to_snapshot(
+                state.pbr_alpha_segment_target,
+                state.pbr_alpha_after_texture,
+                state.pbr_alpha_read_fbo,
+                state.pbr_alpha_width,
+                state.pbr_alpha_height);
+
+        state.pbr_alpha_segment_active = false;
+        state.pbr_alpha_segment_target = 0;
+
+        if (copied)
+        {
+            state.pbr_alpha_pair_ready = true;
+            state.pbr_alpha_snapshot_count++;
+        }
+
+        return copied;
+    }
