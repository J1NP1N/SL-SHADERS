+// v0.33 planar prototype (rough, FX-only). For a floor pixel that SSR could not
+// reflect, mirror the foreground standing above it across its screen-space ground
+// contact and sample the scene color there. Approximate: assumes a vertical
+// screen mirror (no perspective foreshortening). Returns rgb + strength in .a;
+// .a == 0 means "no planar fill here" so the caller leaves the pixel untouched.
+float4 PlanarAvatarFill(float2 uv, float3 floorViewPos)
+{
+    float stepY = BUFFER_RCP_HEIGHT;
+    float floorZ = floorViewPos.z;   // view space, forward is -Z; closer = larger
+    float prevZ = floorZ;
+    float contactV = -1.0;
+
+    [loop]
+    for (int i = 1; i <= SSRPlanarMaxSearch; ++i)
+    {
+        float2 supUV = float2(uv.x, uv.y - (float)i * stepY);
+        if (supUV.y < 0.0 || !InsideFirestormWorld(supUV))
+            break;
+
+        float sd = GetRawDepth(supUV);
+        if (IsBackgroundDepth(sd))
+            break;                    // reached sky before any foreground
+
+        float sz = ReconstructViewPosition(supUV, sd).z;
+        if (sz - prevZ > SSRPlanarContactJump)   // sudden jump closer = contact edge
+        {
+            contactV = supUV.y;
+            break;
+        }
+        prevZ = sz;
+    }
+
+    if (contactV < 0.0)
+        return 0.0;
+
+    float sampleV = 2.0 * contactV - uv.y;       // mirror this floor pixel about contact
+    if (sampleV < 0.0 || sampleV > 1.0)
+        return 0.0;
+
+    float2 sampleUV = float2(uv.x, sampleV);
+    float sd2 = GetRawDepth(sampleUV);
+    if (IsBackgroundDepth(sd2))
+        return 0.0;                   // mirrored point is not foreground
+
+    float3 pc = max(GetSceneLinear(sampleUV).rgb, 0.0);
+    float dist = uv.y - contactV;
+    float fade = saturate(1.0 - dist / max(SSRPlanarFade, 1e-3));
+    return float4(pc, saturate(SSRPlanarStrength) * fade);
+}
