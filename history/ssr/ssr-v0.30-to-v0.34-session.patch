+// v0.31: perspective-correct screen-pixel DDA trace core with a finite depth
+// slab (Morgan McGuire style). Unlike the exponential marcher above it has NO
+// oversized-crossing skip path: it slab-tests every stepped pixel, so thin
+// concave foreground geometry (avatar limbs, gaps between legs) is caught where
+// the ray actually crosses the near surface instead of being skipped as
+// disocclusion. Material response and composite downstream are unchanged.
+bool TraceSSR_DDA(
+    float3 originPos,
+    float3 originNormal,
+    float3 rayDir,
+    out float2 hitUV,
+    out float hitDistance,
+    out float confidence,
+    out float rejectReason)
+{
+    hitUV = 0.0;
+    hitDistance = 0.0;
+    confidence = 0.0;
+    rejectReason = 3.0;
+
+    if (rayDir.z >= -0.001)
+    {
+        rejectReason = 1.0;
+        return false;
+    }
+
+    float3 csOrig = originPos + originNormal * max(SSRRayOriginBias, 0.0);
+    float3 csEnd = csOrig + rayDir * max(SSRMaxDistance, 0.01);
+
+    float4 H0 = MulProj(float4(csOrig, 1.0));
+    float4 H1 = MulProj(float4(csEnd, 1.0));
+    if (abs(H0.w) <= 1e-8 || abs(H1.w) <= 1e-8)
+    {
+        rejectReason = 2.0;
+        return false;
+    }
+
+    float k0 = 1.0 / H0.w;
+    float k1 = 1.0 / H1.w;
+    float3 Q0 = csOrig * k0;
+    float3 Q1 = csEnd * k1;
+
+    float2 viewportSize = max(SLBridgeViewport.zw, float2(1.0, 1.0));
+    float2 P0 = (H0.xy * k0 * 0.5 + 0.5) * viewportSize;
+    float2 P1 = (H1.xy * k1 * 0.5 + 0.5) * viewportSize;
+
+    float2 screenDelta = P1 - P0;
+    if (dot(screenDelta, screenDelta) < 0.0001)
+        P1 += 0.01;
+
+    float2 delta = P1 - P0;
+    bool permute = false;
+    if (abs(delta.x) < abs(delta.y))
+    {
+        permute = true;
+        delta = delta.yx;
+        P0 = P0.yx;
+        P1 = P1.yx;
+    }
+
+    float stepDir = delta.x >= 0.0 ? 1.0 : -1.0;
+    float invdx = stepDir / max(abs(delta.x), 1e-6);
+    float3 dQ = (Q1 - Q0) * invdx;
+    float dk = (k1 - k0) * invdx;
+    float2 dP = float2(stepDir, delta.y * invdx);
+
+    float stride = clamp(SSRDDAStride, 1.0, 4.0);
+    dP *= stride;
+    dQ *= stride;
+    dk *= stride;
+
+    // Skip the receiver pixel itself. The independent normal bias handles the
+    // geometric self-intersection offset; this one-pixel DDA advance prevents
+    // re-reading the exact source pixel as a reflected hit.
+    float2 P = P0 + dP;
+    float3 Q = Q0 + dQ;
+    float k = k0 + dk;
+    float end = P1.x * stepDir;
+
+    // Seed the previous ray-Z estimate at the midpoint of the skipped source
+    // pixel interval so the first tested interval remains one stride wide.
+    float firstMidK = k0 + dk * 0.5;
+    float prevRayZ = (Q0.z + dQ.z * 0.5) /
+        (abs(firstMidK) > 1e-8 ? firstMidK : (firstMidK < 0.0 ? -1e-8 : 1e-8));
+
+    [loop]
+    for (int i = 0; i < SL_SSR_DDA_MAX_STEPS; ++i)
+    {
+        if (i >= SSRDDAMaxSteps || (P.x * stepDir) > end)
+            break;
+
+        float2 nativePixel = permute ? P.yx : P;
+        if (nativePixel.x < 0.0 || nativePixel.y < 0.0 ||
+            nativePixel.x >= viewportSize.x || nativePixel.y >= viewportSize.y)
+        {
+            rejectReason = 2.0;
+            break;
+        }
+
+        float midK = k + dk * 0.5;
+        float rayZNext = (Q.z + dQ.z * 0.5) /
+            (abs(midK) > 1e-8 ? midK : (midK < 0.0 ? -1e-8 : 1e-8));
+        float rayZMin = min(prevRayZ, rayZNext);
+        float rayZMax = max(prevRayZ, rayZNext);
+        prevRayZ = rayZNext;
+
+        float2 nativeUV = (floor(nativePixel) + 0.5) / viewportSize;
+        if (nativeUV.x > 0.0 && nativeUV.x < 1.0 &&
+            nativeUV.y > 0.0 && nativeUV.y < 1.0)
+        {
+            float2 candidateUV = ScreenUVFromFirestormUV(nativeUV);
+            float rawDepth = GetRawDepth(candidateUV);
+
+            if (!IsBackgroundDepth(rawDepth))
+            {
+                float sceneZ = ReconstructViewPosition(candidateUV, rawDepth).z;
+                bool overlapsDepthSlab =
+                    rayZMax >= (sceneZ - max(SSRThickness, 0.0)) &&
+                    rayZMin < sceneZ;
+
+                if (overlapsDepthSlab)
+                {
+                    float safeK = abs(k) > 1e-8 ? k : (k < 0.0 ? -1e-8 : 1e-8);
+                    float3 hitPoint = Q / safeK;
+                    float dist = length(hitPoint - csOrig);
+
+                    hitUV = candidateUV;
+                    hitDistance = dist;
+                    confidence = EdgeConfidence(candidateUV) * DistanceConfidence(dist);
+                    if (confidence > 0.0)
+                    {
+                        rejectReason = 0.0;
+                        return true;
+                    }
+
+                    rejectReason = 5.0;
+                    return false;
+                }
+            }
+        }
+
+        P += dP;
+        Q += dQ;
+        k += dk;
+    }
+
+    return false;
+}
