+float LegacyAuthoredSignal(float4 rawNormal, float4 specInfo)
+{
+    // Detect intent from the raw Firestorm material payload, before user scales.
+    // Either explicit legacy specular RGB or classic-shiny/environment intensity
+    // counts as authored reflection intent.
+    float specSignal = max(specInfo.r, max(specInfo.g, specInfo.b));
+    float envSignal = saturate(rawNormal.b);
+    return max(specSignal, envSignal);
+}
+
+bool LegacyUsesDielectricFallback(float4 rawNormal, float4 specInfo)
+{
+    return LegacyAuthoredSignal(rawNormal, specInfo) <= LegacyFallbackThreshold;
+}
