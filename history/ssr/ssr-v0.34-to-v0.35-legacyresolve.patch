 // -----------------------------------------------------------------------------
+// v0.35 post-trace resolve
+// -----------------------------------------------------------------------------
+
+float SSRReceiverRoughness(float2 screenUV)
+{
+    float4 rawNormal = GetRawNormalData(screenUV);
+    float4 specInfo = GetGBufferSpecular(screenUV);
+
+    if (IsPBR(rawNormal))
+        return saturate(specInfo.g);
+
+    // Firestorm legacy materialF writes the specular exponent/glossiness directly
+    // to specularRect.a. It is lobe-width metadata only: never use it to gate
+    // reflection energy (v0.13 proved RGB can be authoritative with alpha == 0).
+    float glossiness = saturate(specInfo.a);
+    float smooth = pow(glossiness, max(SSRResolveGlossPower, 0.01));
+    return saturate(1.0 - smooth);
+}
+
+float SSRResolveRadiusPx(float2 screenUV, float4 traceMeta)
+{
+    float roughness = SSRReceiverRoughness(screenUV);
+    float distance01 = saturate(traceMeta.r / max(SSRMaxDistance, 1e-3));
+    float effectiveRoughness = saturate(roughness + distance01 * SSRResolveDistanceBlur);
+    return max(SSRResolveMaxBlurPx, 0.0) * effectiveRoughness * effectiveRoughness;
+}
+
+float SSRReceiverBilateralWeight(
+    float centerViewZ,
+    float3 centerNormal,
+    float2 sampleUV)
+{
+    if (!InsideFirestormWorld(sampleUV))
+        return 0.0;
+
+    float sampleDepth = GetRawDepth(sampleUV);
+    if (IsBackgroundDepth(sampleDepth))
+        return 0.0;
+
+    float3 sampleNormal = DecodeFirestormNormalRaw(GetRawNormalData(sampleUV));
+    float normalWeight = pow(saturate(dot(centerNormal, sampleNormal)), max(SSRResolveNormalPower, 1.0));
+
+    float sampleViewZ = abs(ReconstructViewPosition(sampleUV, sampleDepth).z);
+    float tolerance = max(abs(centerViewZ) * max(SSRResolveDepthTolerance, 1e-4), 0.01);
+    float depthWeight = saturate(1.0 - abs(sampleViewZ - centerViewZ) / tolerance);
+    depthWeight *= depthWeight;
+
+    return normalWeight * depthWeight;
+}
+
+float4 SSRResolveHorizontalPS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
+{
+    float4 center = tex2D(SLSSRRawSampler, uv);
+    if (SSRResolveEnable <= 0 || center.a <= 1e-5 || !InsideFirestormWorld(uv))
+        return center;
+
+    float4 meta = tex2D(SLSSRMetaSampler, uv);
+    float radiusPx = SSRResolveRadiusPx(uv, meta);
+    if (radiusPx <= 0.25)
+        return center;
+
+    float centerDepth = GetRawDepth(uv);
+    if (IsBackgroundDepth(centerDepth))
+        return center;
+
+    float centerViewZ = abs(ReconstructViewPosition(uv, centerDepth).z);
+    float3 centerNormal = DecodeFirestormNormalRaw(GetRawNormalData(uv));
+    float2 pixel = float2(1.0 / BUFFER_WIDTH, 0.0);
+    float tapStepPx = radiusPx / 4.0;
+
+    float3 sum = 0.0;
+    float sumW = 0.0;
+
+    [unroll]
+    for (int i = -4; i <= 4; ++i)
+    {
+        float fi = (float)i;
+        float2 suv = uv + pixel * (fi * tapStepPx);
+        float4 sampleSSR = tex2D(SLSSRRawSampler, suv);
+        if (sampleSSR.a <= 1e-5)
+            continue;
+
+        float gaussian = exp2(-0.36 * fi * fi);
+        float bilateral = SSRReceiverBilateralWeight(centerViewZ, centerNormal, suv);
+        float w = gaussian * bilateral;
+        sum += sampleSSR.rgb * w;
+        sumW += w;
+    }
+
+    if (sumW <= 1e-5)
+        return center;
+
+    // Keep center confidence/coverage authoritative. Blur the reflection lobe,
+    // not the geometry-hit mask.
+    return float4(sum / sumW, center.a);
+}
+
+float4 SSRResolveVerticalPS(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target
+{
+    float4 centerRaw = tex2D(SLSSRRawSampler, uv);
+    float4 center = tex2D(SLSSRBlurHSampler, uv);
+    if (SSRResolveEnable <= 0 || centerRaw.a <= 1e-5 || !InsideFirestormWorld(uv))
+        return centerRaw;
+
+    float4 meta = tex2D(SLSSRMetaSampler, uv);
+    float radiusPx = SSRResolveRadiusPx(uv, meta);
+    if (radiusPx <= 0.25)
+        return float4(center.rgb, centerRaw.a);
+
+    float centerDepth = GetRawDepth(uv);
+    if (IsBackgroundDepth(centerDepth))
+        return centerRaw;
+
+    float centerViewZ = abs(ReconstructViewPosition(uv, centerDepth).z);
+    float3 centerNormal = DecodeFirestormNormalRaw(GetRawNormalData(uv));
+    float2 pixel = float2(0.0, 1.0 / BUFFER_HEIGHT);
+    float tapStepPx = radiusPx / 4.0;
+
+    float3 sum = 0.0;
+    float sumW = 0.0;
+
+    [unroll]
+    for (int i = -4; i <= 4; ++i)
+    {
+        float fi = (float)i;
+        float2 suv = uv + pixel * (fi * tapStepPx);
+        float4 sampleRaw = tex2D(SLSSRRawSampler, suv);
+        if (sampleRaw.a <= 1e-5)
+            continue;
+
+        float4 sampleSSR = tex2D(SLSSRBlurHSampler, suv);
+        float gaussian = exp2(-0.36 * fi * fi);
+        float bilateral = SSRReceiverBilateralWeight(centerViewZ, centerNormal, suv);
+        float w = gaussian * bilateral;
+        sum += sampleSSR.rgb * w;
+        sumW += w;
+    }
+
+    if (sumW <= 1e-5)
+        return float4(center.rgb, centerRaw.a);
+
+    return float4(sum / sumW, centerRaw.a);
+}
+
+float SSRLongRayRejectAmount(float4 traceMeta)
+{
+    float d0 = min(SSRLongRayDistanceStart, SSRLongRayDistanceEnd - 1e-3);
+    float d1 = max(SSRLongRayDistanceEnd, d0 + 1e-3);
+    float s0 = min(SSRLongRayStretchStartPx, SSRLongRayStretchEndPx - 1e-3);
+    float s1 = max(SSRLongRayStretchEndPx, s0 + 1e-3);
+
+    float longDistance = smoothstep(d0, d1, traceMeta.r);
+    float longStretch = smoothstep(s0, s1, traceMeta.g);
+
+    // Requiring both signals is intentionally conservative: a distant legitimate
+    // reflection or a nearby large screen displacement alone is not enough.
+    return saturate(longDistance * longStretch);
+}
