+inline constexpr const char basis_probe_ps[] = R"SLGTAO(#version 430 core
+
+#define GTAO_PI 3.14159265358979323846
+#define GTAO_HALF_PI 1.57079632679489661923
+#define GTAO_MAX_SLICES 8
+
+in vec2 vUV;
+
+layout(std140, binding = 13) uniform GTAOConstants
+{
+    mat4 uInvProj;
+    vec4 uSize;
+    vec4 uAO0;
+    vec4 uAO1;
+    vec4 uAO2;
+    vec4 uDenoise;
+    ivec4 uCounts;
+};
+
+layout(binding = 11) uniform sampler2D uDepth;
+layout(binding = 12) uniform sampler2D uNormal;
+layout(binding = 13) uniform sampler2D uInput0;
+layout(binding = 14) uniform sampler2D uInput1;
+layout(binding = 15) uniform sampler2D uInput2;
+
+float saturate1(float x) { return clamp(x, 0.0, 1.0); }
+
+bool insideUV(vec2 uv)
+{
+    return uv.x > 0.0 && uv.x < 1.0 &&
+           uv.y > 0.0 && uv.y < 1.0;
+}
+
+bool isBackgroundDepth(float rawDepth)
+{
+    return rawDepth >= 0.999999;
+}
+
+vec3 reconstructViewPosition(vec2 uv, float rawDepth)
+{
+    vec4 p = uInvProj * vec4(uv * 2.0 - 1.0, rawDepth * 2.0 - 1.0, 1.0);
+    float safeW = abs(p.w) > 1e-8 ? p.w : (p.w < 0.0 ? -1e-8 : 1e-8);
+    return p.xyz / safeW;
+}
+
+vec3 decodeFirestormNormal(vec4 encodedNormal)
+{
+    vec2 fenc = encodedNormal.xy * 4.0 - 2.0;
+    float f = dot(fenc, fenc);
+    float g = sqrt(max(1.0 - f * 0.25, 0.0));
+
+    vec3 n;
+    n.xy = fenc * g;
+    n.z = 1.0 - f * 0.5;
+
+    float len2 = dot(n, n);
+    return len2 > 1e-8 ? n * inversesqrt(len2) : vec3(0.0, 0.0, 1.0);
+}
+
+float hash12(vec2 p)
+{
+    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453);
+}
+
+float arcIntegral(float h, float n, float cosN, float sinN)
+{
+    return 0.25 * (-cos(2.0 * h - n) + cosN + 2.0 * h * sinN);
