+        float tangentLen2 = dot(tangentVS, tangentVS);
+        if (tangentLen2 <= 1e-10)
+        {
+            visibilitySum += 1.0;
+            continue;
+        }
+
+        tangentVS *= inversesqrt(tangentLen2);
+        vec3 slicePlaneNormal = normalize(cross(tangentVS, viewVec));
+        vec3 projectedNormal = centerNormal - slicePlaneNormal * dot(centerNormal, slicePlaneNormal);
+
+        float projectedLength = length(projectedNormal);
+        if (projectedLength <= 1e-5)
