+        float sliceVisibility = projectedLength *
+            (arcIntegral(h0, n, cosN, sinN) + arcIntegral(h1, n, cosN, sinN));
+
+        visibilitySum += sliceVisibility;
+    }
+
+    outProbe = saturate1(visibilitySum / float(activeSlices));
+}
+)SLGTAO";
