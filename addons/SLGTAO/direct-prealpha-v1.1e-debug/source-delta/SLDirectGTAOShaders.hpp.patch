+
+        float phi = (float(slice) + slicePhase) / float(activeSlices) * GTAO_PI;
+        vec2 dir2 = vec2(cos(phi), sin(phi));
+        vec2 tangentUV = clamp(uv + dir2 * texel, texel, vec2(1.0) - texel);
